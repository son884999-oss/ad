# Server-only settings for api/analyze-photo.js and api/promo-text.js.
# Copy to .env.local and fill in. Never use a VITE_ prefix: these must not reach the browser.
GEMINI_API_KEY=
# Optional second key, used only after the first one answers 429 (daily limit). It may be paid: the server stops
# using it once its estimated spend reaches 100 KRW for the day (ledger: outputs/.gemini-key2-usage.json).
GEMINI_API_KEY_2=
# Cheapest text+vision model. Higher-quality alternative: gemini-3.1-flash-lite
# New Google projects/keys may not get the legacy 2.5 models: if gemini-2.5-flash-lite fails, use gemini-3.5-flash-lite.
# Gemini 3.6+ models ignore temperature; the server only sends temperature to gemini-2.x models.
GEMINI_MODEL=gemini-2.5-flash-lite

# Real image-to-video for the 영상 result (api/video-start.js, api/video-status.js). Leave empty to keep
# the browser-made sample video. Format KEY_ID:KEY_SECRET from https://console.higgsfield.ai (server only).
# The secret is shown only once when the key is created; if it is lost, create a new key.
# COST: every 홍보물 만들기 with a video is ONE paid job. MVP default Kling 2.5 Turbo Standard (720p, no sound)
# ≈ $0.042/s list ⇒ ~$0.21 per 5 s clip. Failed/NSFW jobs are not charged. Check https://open.higgsfield.ai/pricing
# Optional: extra browser origins allowed to call /api (comma separated), e.g. a custom domain.
ALLOWED_ORIGINS=
# Paid video also needs this switch. Without VIDEO_ENABLED=1 the key is ignored and the free sample video is used.
VIDEO_ENABLED=
HF_CREDENTIALS=
# Optional. Default kling-video/v2.5-turbo/standard/image-to-video (5 or 10 s).
# Alternative: alibaba/wan-3.0/image-to-video (2–30 s, sound included at the same price, ~$0.10/s at 720p).
HF_VIDEO_MODEL=
# Optional. Kling: 5 (default) or 10. Wan: 2–30 (default 3).
HF_VIDEO_DURATION=
# Optional, Wan only: 480p (default) | 720p | 1080p. Price roughly doubles per step.
HF_VIDEO_RESOLUTION=
